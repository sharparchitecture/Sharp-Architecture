<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- code generators must target netstandard2.0 -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- The generator ships its DLL and PDB directly in the analyzers/ folder of the main
         nupkg (see the None items below), so there is no runtime assembly in lib/ and no
         .pdb left for a symbol package. Suppress snupkg generation, otherwise dotnet pack
         emits an empty .snupkg which NuGet.org rejects with
         "The package does not contain any symbol (.pdb) files." -->
    <IncludeSymbols>false</IncludeSymbols>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Do NOT bump the Roslyn reference above the minimum compiler version you intend to support.
      The compiler refuses to load a source generator that references a NEWER compiler version
      than the running one (warning CS9057), silently disabling code generation.
      Roslyn is backward compatible in the other direction: a generator referencing an older
      compiler version runs fine on newer SDKs.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <!-- special settings for Source Generator Packages -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- ship the portable pdb with the generator so it can be stepped into while debugging -->
    <None Include="$(OutputPath)\$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
